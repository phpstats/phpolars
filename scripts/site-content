#!/usr/bin/env php
<?php

/*
 * Write phpolars' content for phpolars.phpstats.org into site/:
 *   verifications/py-polars-fixtures.json  from tests/pyfixtures.php
 *   verifications/integration.json         the CLI, PHP-FPM, API, and streaming-memory checks
 *   benchmarks/read-group-join.json        from bench/site.php and bench/site.py
 *   benchmarks/thread-count.json           from bench/results/pipeline-linux.json (bench/pipeline.php)
 * The read-group-join benchmark needs uv (for py-polars) and peakmem
 * (bench/csv-pipeline/peakmem.c, on the PATH), and takes a few minutes. Each
 * implementation runs in its own process, so that its peak memory belongs to it.
 * Records are published from the Linux bench VM only.
 *
 * Usage: scripts/site-content [verifications|integration|benchmarks|thread-count ...]
 * The integration part needs php-fpm and cgi-fcgi; PHP_FPM and CGI_FCGI override their paths.
 * PHP and PHPOLARS_EXT select the PHP binary and the extension (the release build by default).
 */

declare(strict_types=1);

$root = dirname(__DIR__);
$php = getenv('PHP') ?: PHP_BINARY;
$ext = getenv('PHPOLARS_EXT') ?: $root.'/target/release/libphp_polars.'.(PHP_OS_FAMILY === 'Darwin' ? 'dylib' : 'so');
$parts = array_slice($argv, 1) ?: ['verifications', 'integration', 'benchmarks', 'thread-count'];
$commit = trim((string) shell_exec('git -C '.escapeshellarg($root).' rev-parse --short HEAD'));
$date = date('Y-m-d');
$cpu = trim((string) (PHP_OS_FAMILY === 'Darwin'
    ? shell_exec('sysctl -n machdep.cpu.brand_string')
    : shell_exec("sed -n 's/^model name\\s*: //p' /proc/cpuinfo | head -1")));
$pyPolars = '1.43.2';
preg_match('/name = "polars"\nversion = "([^"]+)"/', (string) file_get_contents($root.'/Cargo.lock'), $m);
$crate = $m[1];
preg_match('/^version\s*=\s*"([^"]+)"/m', (string) file_get_contents($root.'/Cargo.toml'), $m);
$version = $m[1];
$phpVersion = trim((string) shell_exec(escapeshellarg($php).' -n -r "echo PHP_VERSION;"'));

/** The OS as "Linux, Ubuntu 24.04.5 LTS (x86_64)" or "macOS 26.1 (arm64)". */
function os_name(): string
{
    if (PHP_OS_FAMILY === 'Darwin') {
        return 'macOS '.trim((string) shell_exec('sw_vers -productVersion')).' ('.php_uname('m').')';
    }
    $release = (string) @file_get_contents('/etc/os-release');
    $name = preg_match('/^PRETTY_NAME="?([^"\n]+)"?/m', $release, $m) ? $m[1] : php_uname('r');

    return 'Linux, '.$name.' ('.php_uname('m').')';
}

function run(array $cmd, array $env = []): string
{
    $proc = proc_open($cmd, [1 => ['pipe', 'w'], 2 => STDERR], $pipes, null, $env + getenv());
    $out = stream_get_contents($pipes[1]);
    if (proc_close($proc) !== 0) {
        fwrite(STDERR, 'failed: '.implode(' ', $cmd)."\n");
        exit(1);
    }
    return $out;
}

/**
 * Runs $cmd under /usr/bin/time -l or peakmem and returns its decoded JSON output,
 * with memory_mib (the peak memory footprint on macOS, the peak anonymous memory on
 * Linux) and maxrss_mib (the peak resident set size).
 */
function measured(array $cmd, array $env = []): array
{
    $proc = proc_open([PHP_OS_FAMILY === 'Darwin' ? '/usr/bin/time' : 'peakmem', '-l', ...$cmd], [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, null, $env + getenv());
    $out = stream_get_contents($pipes[1]);
    $err = stream_get_contents($pipes[2]);
    if (proc_close($proc) !== 0) {
        fwrite(STDERR, 'failed: '.implode(' ', $cmd)."\n{$err}");
        exit(1);
    }
    $mib = fn (string $label) => preg_match('/(\d+)\s+'.$label.'/', $err, $m) ? round((int) $m[1] / 2 ** 20, 1) : null;

    return json_decode($out, true, flags: JSON_THROW_ON_ERROR) + ['memory_mib' => $mib('peak memory footprint'), 'maxrss_mib' => $mib('maximum resident set size')];
}

function memory_gb(): float
{
    return preg_match('/^MemTotal:\s+(\d+) kB/m', (string) @file_get_contents('/proc/meminfo'), $m) ? (int) $m[1] / 2 ** 20 : 0.0;
}

function write(string $path, array $data): void
{
    file_put_contents($path, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRESERVE_ZERO_FRACTION)."\n");
    echo "wrote $path\n";
}

if (in_array('verifications', $parts, true)) {
    $tmp = tempnam(sys_get_temp_dir(), 'phpolars-verify');
    run([$php, '-n', '-d', 'extension='.$ext, $root.'/tests/pyfixtures.php'], ['PYFIXTURES_REPORT' => $tmp]);
    $report = json_decode((string) file_get_contents($tmp), true, flags: JSON_THROW_ON_ERROR);
    unlink($tmp);
    // Each case's category, from the prefix of its name in scripts/pyfixtures.py.
    $categories = [
        'Expressions' => ['select', 'int32', 'with', 'bool', 'horizontal', 'when', 'is', 'clip', 'round', 'math', 'trig', 'multi', 'bitwise', 'extend', 'expr',
            'min', 'first', 'arg', 'peaks', 'meta', 'ns', 'reinterpret', 'reshape', 'search', 'rle', 'cut', 'hist', 'cum', 'cumulative', 'shift', 'diff', 'pct', 'rank'],
        'Filtering and sorting' => ['filter', 'sort', 'unique', 'top'],
        'Grouping and summaries' => ['gb', 'group', 'describe', 'value'],
        'Joins' => ['join'],
        'Missing values' => ['fill', 'drop', 'null', 'interpolate'],
        'Reshaping and concatenation' => ['unpivot', 'pivot', 'explode', 'transpose', 'concat', 'melt', 'json'],
        'Windows, rolling, and EWM' => ['over', 'rolling', 'ewm'],
        'Strings' => ['str'],
        'Dates and times' => ['dt', 'date'],
        'Lists, arrays, and structs' => ['list', 'arr', 'struct'],
        'Categoricals and binary' => ['cat', 'bin'],
        'Casts' => ['cast'],
        'DataFrame methods' => ['dataframe', 'head', 'rename'],
        'Series' => ['series'],
        'Functions' => ['fn', 'arange'],
        'Selectors' => ['selectors'],
        'SQL' => ['sql'],
    ];
    $category = [];
    foreach ($categories as $label => $prefixes) {
        foreach ($prefixes as $prefix) {
            $category[$prefix] = $label;
        }
    }
    $cases = [];
    foreach ($report['cases'] as $name => $case) {
        $prefix = explode('_', $name)[0];
        $cases[] = ['name' => $name, 'category' => $category[$prefix] ?? throw new RuntimeException("no category for case {$name}")] + $case;
    }
    $versions = ['py-polars' => $report['polars_version'], 'Polars Rust crate' => $crate, 'PHP' => $phpVersion];
    write($root.'/site/verifications/py-polars-fixtures.json', [
        'title' => 'py-polars',
        'label' => 'py-polars',
        'kind' => 'reference',
        'checked' => sprintf('Column names, data types, and values of %d results: data frame methods, functions, joins, grouping, windows, sorting, casts, SQL, and the str, dt, list, struct, and arr namespaces. Identical inputs in both implementations.', count($cases)),
        'description' => sprintf('scripts/pyfixtures.py runs each case in py-polars and writes tests/fixtures/py/expected.json. tests/pyfixtures.php runs the same cases in phpolars and compares the results. '
            .'phpolars embeds the Polars Rust crate %s; py-polars %s is the release with the closest Rust core. Error statistics cover numeric values only.', $crate, $report['polars_version']),
        'reference' => 'py-polars '.$report['polars_version'],
        'versions' => $versions,
        'inputs' => 'Fixed data frames built identically in scripts/pyfixtures.py and tests/pyfixtures.php: a 6-row data frame of integers, floats, strings, booleans, dates, datetimes, and lists with nulls in every column; lookup tables; a sorted time series; and quotes for as-of joins.',
        'comparison' => [
            ['id' => 'exact', 'kind' => 'exact', 'applies_to' => 'Results without floats; column names, data types, integers, strings, booleans, temporal values, and null positions'],
            ['id' => 'float', 'kind' => 'tolerance', 'rtol' => 1e-9, 'applies_to' => 'Finite floats; no absolute term, so a zero reference requires an exact zero, and all other values compare exactly'],
            ['id' => 'error', 'kind' => 'exact', 'applies_to' => 'Expected exceptions; exception class name, message not compared'],
        ],
        'cases' => $cases,
        'exclusions' => [
            'NaN, INF, and -INF are encoded as {"$float": "NaN"}, {"$float": "INF"}, and {"$float": "-INF"} and compared exactly; they count as values compared and are excluded from the error statistics.',
            'Methods and arguments without a case are not compared.',
        ],
        'reproduce' => [
            "uv run --with 'polars==".$report['polars_version']."' --with numpy python scripts/pyfixtures.py",
            'cargo build --release',
            'scripts/site-content verifications',
        ],
        'source' => 'tests/fixtures/py/expected.json',
        'data' => 'scripts/pyfixtures.py',
        'environment' => ['date' => $date, 'commit' => $commit, 'php' => $phpVersion, 'os' => os_name()],
    ]);
}

if (in_array('integration', $parts, true)) {
    // Each check returns [status, quantity, reason].
    $capture = function (array $cmd, array $env = []): array {
        $proc = proc_open($cmd, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, null, $env + getenv());
        $out = stream_get_contents($pipes[1]).stream_get_contents($pipes[2]);
        return [proc_close($proc), trim($out)];
    };
    $cases = [];
    [$code, $out] = $capture([$php, '-n', '-d', 'extension='.$ext, $root.'/tests/deployment.php']);
    $cases[] = ['name' => 'PHP CLI', 'quantity' => 'version matches Cargo.toml, a group_by result, and the thread pool size',
        'status' => $code === 0 ? 'pass' : 'fail'] + ($code === 0 ? [] : ['reason' => 'tests/deployment.php failed under the CLI: '.strtok($out, "\n")]);
    // PHP_FPM and CGI_FCGI name the binaries where they are not php-fpm and cgi-fcgi on the PATH, such as Ubuntu's php-fpm8.5.
    $fpm = getenv('PHP_FPM') ?: trim((string) shell_exec('command -v php-fpm'));
    $fcgi = getenv('CGI_FCGI') ?: trim((string) shell_exec('command -v cgi-fcgi'));
    if ($fpm === '' || $fcgi === '') {
        $cases[] = ['name' => 'PHP-FPM', 'quantity' => 'the same assertions through a FastCGI request to a php-fpm worker', 'status' => 'skipped',
            'reason' => 'php-fpm or cgi-fcgi is not installed on the machine that made this record; CI runs this check in the packaging workflow.'];
    } else {
        [$code, $out] = $capture([$root.'/scripts/check-fpm'], ['PHP' => $php, 'PHP_FPM' => $fpm, 'CGI_FCGI' => $fcgi, 'PHPOLARS_EXT' => $ext]);
        $cases[] = ['name' => 'PHP-FPM', 'quantity' => 'the same assertions through a FastCGI request to a php-fpm worker',
            'status' => $code === 0 ? 'pass' : 'fail'] + ($code === 0 ? [] : ['reason' => 'scripts/check-fpm failed: '.strtok($out, "\n")]);
    }
    // The latest release before this version, so a release commit is not compared with itself.
    $tag = trim((string) shell_exec('git -C '.escapeshellarg($root).' describe --tags --abbrev=0 --exclude '.escapeshellarg('v'.$version).' 2>/dev/null'));
    $old = tempnam(sys_get_temp_dir(), 'phpolars-stubs');
    file_put_contents($old, (string) shell_exec('git -C '.escapeshellarg($root).' show '.escapeshellarg("$tag:stubs/phpolars.php")));
    [$code, $out] = $capture([$php, '-n', '-d', 'extension='.$ext, $root.'/scripts/api-compat.php', $old]);
    unlink($old);
    preg_match('/(\d+) signatures checked, (\d+) problems/', $out, $m);
    $cases[] = ['name' => "API compatibility with {$tag}", 'quantity' => sprintf('%s functions and methods of %s still exist, with its parameters as a prefix of today\'s', $m[1] ?? 'the', $tag),
        'status' => $code === 0 ? 'pass' : 'fail', 'n_compared' => isset($m[1]) ? (int) $m[1] : null] + ($code === 0 ? [] : ['reason' => ($m[2] ?? 'some').' signatures are missing or changed.']);
    [$code, $out] = $capture([$php, '-n', '-d', 'extension='.$ext, $root.'/tests/memory.php'], ['PHPOLARS_EXT' => $ext]);
    preg_match('/a ([\d.]+) MB CSV adds ([\d.-]+) MB of peak RSS/', $out, $m);
    $cases[] = ['name' => 'Streaming filter memory', 'quantity' => isset($m[1])
            ? sprintf('peak RSS added by a streaming filter that keeps 4%% of a %s MB CSV: %s MB, against a limit of half the file', $m[1], $m[2])
            : 'peak RSS added by a streaming filter that keeps 4% of a CSV, against a limit of half the file',
        'status' => $code === 0 ? 'pass' : 'fail'] + ($code === 0 ? [] : ['reason' => 'tests/memory.php failed: '.strtok($out, "\n")]);
    write($root.'/site/verifications/integration.json', [
        'title' => 'Runtime checks',
        'label' => 'Runtime checks',
        'kind' => 'integration',
        'checked' => 'Extension loading and execution under the PHP CLI and PHP-FPM, API compatibility with the previous release, and the peak resident set size of a selective streaming scan.',
        'description' => 'tests/deployment.php checks the extension version, a group_by result, and the thread pool size; scripts/check-fpm runs it in a php-fpm worker through FastCGI. '
            .'scripts/api-compat.php checks the previous release tag\'s stubs against the extension. tests/memory.php runs two streaming filters of a generated CSV in separate processes and compares their peak resident set sizes. '
            .'scripts/check runs the CLI, API, and memory checks before a release, on Ubuntu 24.04 and macOS 15 with PHP 8.3, 8.4, and 8.5 in CI; the packaging workflow runs the PHP-FPM check in the production container.',
        'versions' => ['phpolars' => $version, 'Polars Rust crate' => $crate, 'PHP' => $phpVersion],
        'comparison' => [['id' => 'check', 'kind' => 'exact', 'applies_to' => 'Each check; exit status of its script']],
        'cases' => $cases,
        'reproduce' => ['cargo build --release', 'scripts/site-content integration'],
        'source' => 'scripts/check',
        'environment' => ['date' => $date, 'commit' => $commit, 'php' => $phpVersion, 'os' => os_name()],
    ]);
}

// The read, group, and join workload, shared by the benchmark and its description.
$readGroupJoin = [
    'title' => 'Read, group, and join',
    'label' => 'Read, group, and join',
    'description' => 'Reads a CSV, groups it by 50 keys with a mean, a sum, and a count, and joins it with a lookup table on an integer key.',
    'workload' => '1,000,000-row CSV (22 MB) and a 100,000-row lookup table',
    'implementations' => [
        'phpolars' => 'php_polars extension; Polars Rust crate %crate%, release profile',
        'py-polars' => 'py-polars %pypolars% on Python %python%, with its own build of the Polars engine',
        'plain PHP arrays' => 'PHP %php% arrays, fgetcsv, one grouping loop, and a hash join; php_polars loaded, not called',
    ],
    'measure' => 'Elapsed time',
    'unit' => 'ms',
    'statistic' => 'median',
    'method' => 'One untimed warm-up, then five timed runs per case. The clock (hrtime in PHP, perf_counter_ns in Python) covers the case\'s call only; '
        .'loading the inputs of the group and join cases, runtime startup, and conversion of Polars results to PHP arrays are excluded. The data files are written immediately before the runs and are in the page cache.',
    'time_spent_in' => 'the measured process: the PHP process for phpolars and plain PHP, the Python process for py-polars',
    'memory_measure' => 'peak anonymous memory',
    'memory_method' => 'RssAnon of each implementation\'s process over all three cases, sampled every millisecond by bench/csv-pipeline/peakmem.c; mapped file pages excluded.',
];

if (in_array('benchmarks', $parts, true)) {
    if (PHP_OS_FAMILY !== 'Linux') {
        fwrite(STDERR, "The benchmarks are published from the Linux bench VM only.\n");
        exit(1);
    }
    $data = sys_get_temp_dir().'/phpolars-site-bench';
    @mkdir($data);
    mt_srand(42);
    $labels = array_map(fn ($i) => sprintf('label%03d', $i), range(0, 499));
    $out = fopen("$data/dim.csv", 'w');
    fwrite($out, "k,label,w\n");
    for ($k = 0; $k < 100_000; $k++) {
        fprintf($out, "%d,%s,%.4f\n", $k, $labels[mt_rand(0, 499)], mt_rand() / mt_getrandmax());
    }
    fclose($out);
    $out = fopen("$data/facts.csv", 'w');
    fwrite($out, "k,g,x,y\n");
    for ($i = 0; $i < 1_000_000; $i++) {
        $x = mt_rand(1, 50) === 1 ? '' : (string) mt_rand(0, 1000);
        fprintf($out, "%d,g%02d,%s,%.4f\n", mt_rand(0, 99_999), mt_rand(0, 49), $x, mt_rand() / mt_getrandmax() * 100);
    }
    fclose($out);

    $phpCmd = [$php, '-n', '-d', 'memory_limit=-1', '-d', 'extension='.$ext, $root.'/bench/site.php', $data, '5'];
    $polarsRun = measured([...$phpCmd, 'phpolars']);
    $plainRun = measured([...$phpCmd, 'plain']);
    $threads = (string) $polarsRun['threads'];
    // A virtual environment with py-polars, so the measured process is Python itself, not uv.
    run(['uv', 'venv', '--quiet', '--allow-existing', "$data/venv"]);
    run(['uv', 'pip', 'install', '--quiet', '--python', "$data/venv/bin/python", 'polars=='.$pyPolars]);
    $python = "$data/venv/bin/python";
    $pyRun = measured([$python, $root.'/bench/site.py', $data, '5'], ['POLARS_MAX_THREADS' => $threads]);
    $runs = ['phpolars' => $polarsRun, 'py-polars' => $pyRun, 'plain PHP arrays' => $plainRun];
    $checks = $polarsRun['check'] + $plainRun['check'] + $pyRun['check'];
    if (count(array_unique(array_map('json_encode', $checks))) !== 1) {
        fwrite(STDERR, 'implementations disagree: '.json_encode($checks)."\n");
        exit(1);
    }
    $caseNames = [
        'read' => 'Read a 1M-row CSV',
        'group_by' => 'Group 1M rows by 50 keys: mean, sum, count',
        'join' => 'Inner join 1M rows with a 100k-row table',
    ];
    $rows = [];
    foreach ($caseNames as $key => $case) {
        foreach ($runs as $impl => $run) {
            $reps = $run['results'][$impl][$key];
            $sorted = $reps;
            sort($sorted);
            $rows[] = ['case' => $case, 'implementation' => $impl, 'value' => $sorted[intdiv(count($sorted), 2)], 'reps' => $reps,
                'peak_memory_mib' => $run['memory_mib'], 'peak_rss_mib' => $run['maxrss_mib']];
        }
    }
    $fill = ['%crate%' => $crate, '%pypolars%' => $pyRun['polars'], '%python%' => $pyRun['python'], '%php%' => $polarsRun['php']];
    $readGroupJoin['implementations'] = array_map(fn ($s) => strtr($s, $fill), $readGroupJoin['implementations']);
    write($root.'/site/benchmarks/read-group-join.json', $readGroupJoin + [
        'dataset' => ['rows' => 1_000_000, 'bytes' => filesize("$data/facts.csv"), 'sha256' => hash_file('sha256', "$data/facts.csv"),
            'columns' => 'k: 100,000 keys, g: 50 groups, x: integers with 2% missing, y: floats', 'lookup_rows' => 100_000],
        'check' => ['groups' => reset($checks)['groups'], 'joined_rows' => reset($checks)['joined'], 'agree' => true],
        'environment' => ['cpu' => $cpu, 'cores' => (int) trim((string) shell_exec('nproc')), 'memory_gb' => (int) round(memory_gb()),
            'os' => os_name(), 'php' => $polarsRun['php'],
            'versions' => ['Polars Rust crate' => $crate, 'py-polars' => $pyRun['polars'], 'Python' => $pyRun['python']],
            'threads' => ['phpolars' => (int) $threads, 'py-polars' => (int) $pyRun['threads'], 'plain PHP arrays' => 1],
            'cache' => 'warm', 'repeats' => 5, 'warmups' => 1, 'date' => $date, 'commit' => $commit],
        'rows' => $rows,
        'reproduce' => ['cc -O2 -o peakmem bench/csv-pipeline/peakmem.c && export PATH="$PWD:$PATH"', 'cargo build --release', 'scripts/site-content benchmarks'],
        'source' => 'bench/site.php',
    ]);
}

if (in_array('thread-count', $parts, true)) {
    // The record of bench/pipeline.php, which runs on the bench VM and writes bench/results/pipeline-linux.json.
    $result = json_decode((string) file_get_contents($root.'/bench/results/pipeline-linux.json'), true, flags: JSON_THROW_ON_ERROR);
    $rows = [];
    foreach ($result['results'] as $impl => $r) {
        $notes = ['phpolars, 4 threads' => '4 threads on 2 cores', 'plain PHP arrays (fgetcsv loop)' => 'Running totals only'];
        $rows[] = ['case' => '1M-row CSV pipeline', 'implementation' => $impl, 'value' => $r['median_ms'], 'reps' => $r['ms'],
            'peak_memory_mib' => $r['memory_mib'], 'peak_rss_mib' => $r['maxrss_mib']] + (isset($notes[$impl]) ? ['note' => $notes[$impl]] : []);
    }
    $env = $result['environment'];
    write($root.'/site/benchmarks/thread-count.json', [
        'title' => 'Thread count',
        'label' => 'Thread count',
        'description' => 'Reads a CSV, keeps the rows where x > 500, groups them by g, computes the mean of y and the count of x, sorts by g, and returns PHP arrays.',
        'workload' => sprintf('%s-row CSV (%d MB)', number_format($result['dataset']['rows']), round($result['dataset']['bytes'] / 1e6)),
        'dataset' => $result['dataset'] + ['generator' => 'bench/make-csv.php, seed 42: g (50 string values), x (integers, about 2% missing), y (floats)'],
        'check' => ['agree_with_plain_php' => true, 'rule' => 'the same groups and counts, and means within 1e-9'],
        'implementations' => [
            'phpolars, 1 thread' => 'php_polars extension, php_polars.max_threads=1',
            'phpolars, 2 threads (default)' => 'php_polars extension, php_polars.max_threads=2',
            'phpolars, 4 threads' => 'php_polars extension, php_polars.max_threads=4',
            'plain PHP arrays (fgetcsv loop)' => 'PHP without extensions (php -n): fgetcsv and running totals in an array',
        ],
        'measure' => 'Elapsed time',
        'unit' => 'ms',
        'statistic' => 'median',
        'method' => 'Each implementation runs in its own PHP process: one untimed warm-up, then seven timed runs. The clock (hrtime) runs from reading the file through building the PHP arrays, including parsing and conversion; PHP startup excluded.',
        'time_spent_in' => 'the PHP process',
        'memory_measure' => 'peak anonymous memory',
        'memory_method' => 'RssAnon of the process over all runs, sampled every millisecond by bench/csv-pipeline/peakmem.c; mapped file pages excluded.',
        'environment' => ['cpu' => $env['cpu'], 'cores' => $env['cores'], 'memory_gb' => 8, 'os' => $env['os'], 'php' => $env['php'],
            'versions' => ['Polars Rust crate' => $crate], 'threads' => array_map(fn ($r) => $r['threads'] ?? 1, $result['results']),
            'cache' => 'warm', 'repeats' => count(reset($result['results'])['ms']), 'warmups' => 1, 'date' => $env['date'], 'commit' => $env['commit']],
        'rows' => $rows,
        'reproduce' => [
            'php bench/make-csv.php 1000000 bench/data.csv',
            'cc -O2 -o peakmem bench/csv-pipeline/peakmem.c && export PATH="$PWD:$PATH"',
            'cargo build --release',
            'PHPOLARS_EXTENSION=target/release/libphp_polars.so php bench/pipeline.php bench/data.csv 7 > bench/results/pipeline-linux.json',
            'scripts/site-content thread-count',
        ],
        'source' => 'bench/results/pipeline-linux.json',
    ]);
}
