{
    "name": "phpstats/phpolars",
    "description": "Polars data frames for PHP, as a native Rust extension",
    "type": "php-ext",
    "license": "MIT",
    "require": {
        "php": ">=8.3 <8.6"
    },
    "php-ext": {
        "extension-name": "php_polars",
        "build-path": "pie",
        "support-nts": true,
        "support-zts": false,
        "os-families": ["linux", "darwin"],
        "download-url-method": ["pre-packaged-binary", "composer-default"]
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13"
    }
}
